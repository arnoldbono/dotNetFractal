<UserControl x:Class="dotNetFractal.Uno.Views.DisplaySettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:dotNetFractal.Uno"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DisplaySettingsViewModel, IsDesignTimeCreatable=True}">
    <StackPanel BorderBrush="Gray" BorderThickness="1" Padding="10">
        <TextBlock Text="Image Display:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <CheckBox Content="Stretch image to window size" 
                  IsChecked="{Binding StretchImage, Mode=TwoWay}" 
                  Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
