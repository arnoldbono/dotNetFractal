<UserControl x:Class="dotNetFractal.Uno.Views.ImageResolutionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:dotNetFractal.Uno"
             xmlns:converters="using:dotNetFractal.Uno.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:EnumBooleanConverter x:Key="EnumBooleanConverterKey"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Select:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Margin="0,5,0,0">
                <RadioButton GroupName="Resolution" Content="Full HD" 
                    IsChecked="{Binding Path=SelectedResolution, Converter={StaticResource EnumBooleanConverterKey}, ConverterParameter=FullHD, Mode=TwoWay}" />
                <RadioButton GroupName="Resolution" Content="4K" 
                    IsChecked="{Binding Path=SelectedResolution, Converter={StaticResource EnumBooleanConverterKey}, ConverterParameter=UltraHD, Mode=TwoWay}" />
                <RadioButton GroupName="Resolution" Content="Custom" 
                    IsChecked="{Binding Path=SelectedResolution, Converter={StaticResource EnumBooleanConverterKey}, ConverterParameter=Custom, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <TextBlock Text="Resolution:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,5,0,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Width:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <TextBox Text="{Binding Width, Mode=TwoWay}" Width="80" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center" IsReadOnly="{Binding ReadOnly}"/>
                <TextBlock Text="Height:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <TextBox Text="{Binding Height, Mode=TwoWay}" Width="80" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center" IsReadOnly="{Binding ReadOnly}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
