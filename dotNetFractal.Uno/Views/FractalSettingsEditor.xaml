<UserControl x:Class="dotNetFractal.Uno.Views.FractalSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:dotNetFractal.Uno.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FractalSettingsViewModel, IsDesignTimeCreatable=True}">
    <StackPanel BorderBrush="Gray" BorderThickness="1" Padding="10">
        <TextBlock Text="Settings:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Margin="0,5,0,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Max Iterations:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Text="{Binding MaxIterations, Mode=TwoWay}" Width="80" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Max Color Steps:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Text="{Binding MaxColorSteps, Mode=TwoWay}" Width="80" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="First Color Step:" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Text="{Binding FirstColorStep, Mode=TwoWay}" Width="80" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
            <CheckBox Content="Smooth Coloring" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding SmoothColoring, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <CheckBox Content="High Precision" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding HighPrecision, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,5,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
