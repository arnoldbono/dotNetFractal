<UserControl x:Class="dotNetFractal.Uno.Views.ColorMapEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:dotNetFractal.Uno.ViewModels"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Color map bitmap display -->
        <StackPanel Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Color Gradient Preview" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border BorderBrush="Black" BorderThickness="1" Height="20" Margin="0,5,0,0">
                <Image Source="{Binding ColorMapImage}" Stretch="Fill"/>
            </Border>
        </StackPanel>

        <!-- Color table -->
        <StackPanel Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <TextBlock Text="Color Map Values" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Note: Uno doesn't have DataGrid, using ListView with custom template -->
                <ListView Grid.Column="0"
                          ItemsSource="{Binding Colors}" 
                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                          MaxHeight="200"
                          BorderBrush="Gray"
                          BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Red" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Red}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Green" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Green}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Blue" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Blue}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Fraction" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Fraction}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                    <Button Content="Add" 
                            Width="60" 
                            Margin="0,0,0,5"
                            Command="{Binding AddColorCommand}"/>
                    <Button Content="Delete" 
                            Width="60"
                            Margin="0,0,0,5"
                            Command="{Binding DeleteColorCommand}"/>
                    <Button Content="Reset" 
                            Width="60"
                            Command="{Binding ResetColorCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
