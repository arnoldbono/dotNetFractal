<UserControl x:Class="dotNetFractal.Uno.Views.FractalAreaEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:dotNetFractal.Uno"
             xmlns:converters="using:dotNetFractal.Uno.Converters"
             xmlns:vm="using:dotNetFractal.Uno.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FractalAreaViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:FractalUnitConverter x:Key="FractalUnitConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Coordinates Grid -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Cx:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Cx, Converter={StaticResource FractalUnitConverter}, Mode=TwoWay}" Margin="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="0" Grid.Row="1" Text="Cy:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Cy, Converter={StaticResource FractalUnitConverter}, Mode=TwoWay}" Margin="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="0" Grid.Row="2" Text="Center X:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding CenterX, Converter={StaticResource FractalUnitConverter}, Mode=TwoWay}" Margin="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="0" Grid.Row="3" Text="Center Y:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding CenterY, Converter={StaticResource FractalUnitConverter}, Mode=TwoWay}" Margin="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="0" Grid.Row="4" Text="Width:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding Width, Converter={StaticResource FractalUnitConverter}, Mode=TwoWay}" Margin="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="0" Grid.Row="5" Text="Height:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding Height, Converter={StaticResource FractalUnitConverter}, Mode=TwoWay}" Margin="2" VerticalAlignment="Center" />
        </Grid>

        <!-- Plate and Julia Set -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Plate:" VerticalAlignment="Center" Margin="0,5,5,5"/>
            <ComboBox Grid.Column="1" Grid.Row="0" SelectedIndex="{Binding SelectedPlate, Mode=TwoWay}" ItemsSource="{Binding Plates}" Margin="2" VerticalAlignment="Center" />
            <CheckBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Content="Julia Set" IsChecked="{Binding JuliaSet, Mode=TwoWay}" Margin="2,5,2,2" />
        </Grid>
    </Grid>
</UserControl>
