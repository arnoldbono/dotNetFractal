<Window x:Class="dotNetFractal.WPF.Presentation.DistributionGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dotNetFractal.WPF.Presentation"
        mc:Ignorable="d"
        Title="Iteration Distribution Graph" 
        Height="600" 
        Width="900"
        Background="#FF2D2D30">
    <!-- WindowStartupLocation="CenterOwner" -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Fractal Iteration Distribution" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,8"/>

        <!-- Statistics -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="Total Pixels: " FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalPixels}" Margin="5,0,20,0"/>
            <TextBlock Text="Max Iteration: " FontWeight="Bold"/>
            <TextBlock Text="{Binding MaxIteration}" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Graph Canvas -->
        <Border Grid.Row="2" 
                BorderBrush="#FF3F3F46" 
                BorderThickness="1" 
                Background="#FF1E1E1E"
                Margin="0,0,0,10"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <!-- Y-axis label -->
                <TextBlock Grid.Row="1" 
                           Grid.Column="0" 
                           Text="Scaled Count (0-100)" 
                           FontSize="14"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           TextWrapping="NoWrap">
                    <TextBlock.LayoutTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-90"/>
                        </TransformGroup>
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!-- X-axis label -->
                <TextBlock Grid.Row="2" 
                           Grid.Column="1" 
                           FontSize="14"
                           Text="Iteration Number" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <!-- Graph area -->
                <Canvas x:Name="GraphCanvas" 
                        Grid.Row="1" 
                        Grid.Column="1" 
                        Background="#FF252526"
                        Margin="10"/>
            </Grid>
        </Border>

        <!-- Legend -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Rectangle Width="20" Height="10" Fill="#FF0078D7" Margin="0,0,5,0"/>
            <TextBlock Text="Iteration Distribution (scaled to max = 100)" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
